<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Girls Choice | Beauty & Fashion</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@300;400;500;600;700&display=swap');

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{scroll-behavior:smooth}

body{
  font-family:Poppins,sans-serif;
  background:#fff7fb;
  color:#3b2632;
  overflow-x:hidden;
}

/* Floating background */
body:before,
body:after{
  content:"♡";
  position:fixed;
  font-size:170px;
  color:rgba(255,105,180,.06);
  z-index:-1;
  animation:float 7s ease-in-out infinite;
}
body:before{top:10%;left:-50px}
body:after{bottom:5%;right:-40px;animation-delay:2s}

@keyframes float{
  0%,100%{transform:translateY(0) rotate(0)}
  50%{transform:translateY(-25px) rotate(8deg)}
}

/* Header */
header{
  position:sticky;
  top:0;
  z-index:1000;
  backdrop-filter:blur(15px);
  background:rgba(255,255,255,.88);
  border-bottom:1px solid #ffd6e8;
}

.nav{
  max-width:1200px;
  margin:auto;
  min-height:75px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:12px 20px;
}

.logo{
  font-family:"Playfair Display",serif;
  font-size:30px;
  color:#e83e8c;
  text-decoration:none;
}

.logo span{color:#5b2941}

nav{
  display:flex;
  gap:25px;
  align-items:center;
}

nav a{
  text-decoration:none;
  color:#492b3a;
  font-weight:500;
  transition:.3s;
}

nav a:hover{color:#e83e8c}

.admin-btn{
  border:0;
  background:#fff0f7;
  color:#d62d79;
  padding:9px 15px;
  border-radius:30px;
  cursor:pointer;
  font-weight:600;
}

/* Hero */
.hero{
  min-height:620px;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:80px 20px;
  position:relative;
  background:
    radial-gradient(circle at 20% 20%,#ffd9eb 0,transparent 30%),
    radial-gradient(circle at 80% 80%,#ffe9f3 0,transparent 35%),
    linear-gradient(135deg,#fff8fc,#fff);
}

.hero-content{
  max-width:850px;
  animation:fadeUp 1s ease;
}

.badge{
  display:inline-block;
  padding:9px 18px;
  border-radius:30px;
  background:#ffe1ef;
  color:#d62d79;
  font-size:14px;
  font-weight:600;
  margin-bottom:20px;
}

.hero h1{
  font-family:"Playfair Display",serif;
  font-size:clamp(48px,8vw,88px);
  line-height:1;
  color:#321c29;
}

.hero h1 span{
  color:#e83e8c;
}

.hero p{
  max-width:650px;
  margin:25px auto;
  color:#765868;
  font-size:17px;
  line-height:1.8;
}

.buttons{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:15px;
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  padding:14px 25px;
  border-radius:40px;
  text-decoration:none;
  font-weight:600;
  transition:.35s;
  cursor:pointer;
  border:0;
}

.btn:hover{
  transform:translateY(-4px);
  box-shadow:0 12px 30px rgba(232,62,140,.2);
}

.primary{
  background:linear-gradient(135deg,#e83e8c,#ff76b5);
  color:white;
}

.secondary{
  background:white;
  color:#d62d79;
  border:1px solid #ffc5dd;
}

/* Sections */
section{
  max-width:1200px;
  margin:auto;
  padding:80px 20px;
}

.section-title{
  text-align:center;
  margin-bottom:45px;
}

.section-title small{
  color:#e83e8c;
  font-weight:700;
  letter-spacing:2px;
}

.section-title h2{
  font-family:"Playfair Display",serif;
  font-size:45px;
  margin-top:8px;
}

/* Products */
.filters{
  display:flex;
  justify-content:center;
  gap:10px;
  flex-wrap:wrap;
  margin-bottom:35px;
}

.filter{
  border:1px solid #ffd0e3;
  background:white;
  color:#703e56;
  padding:9px 17px;
  border-radius:25px;
  cursor:pointer;
}

.filter.active,
.filter:hover{
  background:#e83e8c;
  color:white;
}

.products{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:24px;
}

.card{
  background:white;
  border-radius:24px;
  overflow:hidden;
  box-shadow:0 8px 30px rgba(100,40,70,.08);
  transition:.4s;
  border:1px solid #ffe3ef;
  animation:fadeUp .7s ease both;
}

.card:hover{
  transform:translateY(-10px);
  box-shadow:0 20px 45px rgba(232,62,140,.15);
}

.product-img{
  width:100%;
  height:260px;
  object-fit:cover;
  display:block;
}

.card-body{padding:18px}

.category{
  font-size:12px;
  color:#e83e8c;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:1px;
}

.card h3{
  margin:7px 0;
  font-size:18px;
}

.price{
  color:#d62d79;
  font-weight:700;
  font-size:18px;
}

.card-actions{
  display:flex;
  gap:8px;
  margin-top:15px;
}

.card-actions a,
.card-actions button{
  flex:1;
  padding:10px;
  border-radius:12px;
  border:0;
  cursor:pointer;
  text-decoration:none;
  text-align:center;
  font-weight:600;
}

.buy{
  background:#e83e8c;
  color:white;
}

.view{
  background:#fff0f7;
  color:#d62d79;
}

/* About */
.about{
  background:white;
  border-radius:35px;
  padding:55px;
  box-shadow:0 10px 40px rgba(80,30,60,.06);
}

.about-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:45px;
  align-items:center;
}

.about h2{
  font-family:"Playfair Display",serif;
  font-size:45px;
  margin-bottom:18px;
}

.about p{
  color:#725766;
  line-height:1.9;
}

.features{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:15px;
}

.feature{
  padding:22px;
  border-radius:20px;
  background:#fff5fa;
  border:1px solid #ffe0ed;
}

.feature strong{
  display:block;
  margin-bottom:5px;
  color:#d62d79;
}

/* Contact */
.contact{
  text-align:center;
}

.contact-box{
  background:linear-gradient(135deg,#ffe1ef,#fff);
  padding:55px 25px;
  border-radius:35px;
}

.contact-box h2{
  font-family:"Playfair Display",serif;
  font-size:45px;
}

.contact-box p{
  margin:15px auto 25px;
  color:#755668;
}

/* Footer */
footer{
  background:#321c29;
  color:#ffeaf3;
  text-align:center;
  padding:35px 20px;
}

footer strong{
  color:#ff78b8;
}

/* Admin Modal */
.modal{
  display:none;
  position:fixed;
  inset:0;
  z-index:2000;
  background:rgba(30,10,20,.65);
  backdrop-filter:blur(8px);
  align-items:center;
  justify-content:center;
  padding:20px;
}

.modal.show{display:flex}

.modal-box{
  width:min(600px,100%);
  background:white;
  border-radius:25px;
  padding:30px;
  max-height:90vh;
  overflow:auto;
  animation:zoom .3s ease;
}

.modal-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:25px;
}

.close{
  border:0;
  background:#fff0f7;
  color:#d62d79;
  width:38px;
  height:38px;
  border-radius:50%;
  cursor:pointer;
  font-size:20px;
}

.form-group{
  margin-bottom:15px;
}

.form-group label{
  display:block;
  margin-bottom:6px;
  font-size:14px;
  font-weight:600;
}

.form-group input,
.form-group select{
  width:100%;
  padding:13px;
  border:1px solid #ffd0e3;
  border-radius:12px;
  outline:none;
  font-family:inherit;
}

.form-group input:focus,
.form-group select:focus{
  border-color:#e83e8c;
}

.admin-products{
  margin-top:30px;
}

.admin-item{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:12px;
  border-bottom:1px solid #ffe2ed;
}

.delete{
  border:0;
  background:#ffe7ee;
  color:#d62855;
  padding:7px 10px;
  border-radius:8px;
  cursor:pointer;
}

/* Toast */
.toast{
  position:fixed;
  bottom:25px;
  left:50%;
  transform:translate(-50%,120px);
  background:#321c29;
  color:white;
  padding:13px 22px;
  border-radius:30px;
  z-index:5000;
  transition:.4s;
}

.toast.show{
  transform:translate(-50%,0);
}

/* Animations */
@keyframes fadeUp{
  from{
    opacity:0;
    transform:translateY(30px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

@keyframes zoom{
  from{transform:scale(.85);opacity:0}
  to{transform:scale(1);opacity:1}
}

/* Responsive */
@media(max-width:900px){
  .products{grid-template-columns:repeat(2,1fr)}
  .about-grid{grid-template-columns:1fr}
}

@media(max-width:600px){
  nav a{display:none}
  .logo{font-size:25px}
  .hero{min-height:570px}
  .hero h1{font-size:55px}
  .products{grid-template-columns:1fr}
  .about{padding:30px 20px}
  .about h2,
  .contact-box h2{font-size:36px}
  .features{grid-template-columns:1fr}
  .product-img{height:300px}
}
</style>
</head>

<body>

<header>
  <div class="nav">
    <a class="logo" href="#">Girls Choice ♡</a>

    <nav>
      <a href="#home">Home</a>
      <a href="#shop">Shop</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
      <button class="admin-btn" onclick="openAdmin()">⚙ Admin</button>
    </nav>
  </div>
</header>

<main>

<!-- HERO -->
<section class="hero" id="home">
  <div class="hero-content">
    <span class="badge">✨ Beauty • Fashion • Lifestyle</span>

    <h1>
      Welcome to <span>Girls Choice</span>
    </h1>

    <p>
      Discover beautiful products selected specially for you.
      Shop your favorite beauty and fashion items with Girls Choice.
    </p>

    <div class="buttons">
      <a class="btn primary"
         href="https://wa.me/c/923706903659"
         target="_blank">
        🛍 Shop Now
      </a>

      <a class="btn secondary" href="#shop">
        Explore Products
      </a>
    </div>
  </div>
</section>

<!-- SHOP -->
<section id="shop">

  <div class="section-title">
    <small>OUR COLLECTION</small>
    <h2>Shop Your Favorites</h2>
  </div>

  <div class="filters">
    <button class="filter active" onclick="filterProducts('All',this)">All</button>
    <button class="filter" onclick="filterProducts('Beauty',this)">Beauty</button>
    <button class="filter" onclick="filterProducts('Fashion',this)">Fashion</button>
    <button class="filter" onclick="filterProducts('Jewellery',this)">Jewellery</button>
    <button class="filter" onclick="filterProducts('Accessories',this)">Accessories</button>
  </div>

  <div class="products" id="products"></div>

</section>

<!-- ABOUT -->
<section id="about">

  <div class="about">
    <div class="about-grid">

      <div>
        <small style="color:#e83e8c;font-weight:bold;letter-spacing:2px;">
          ABOUT US
        </small>

        <h2>Made for girls who love beautiful things ♡</h2>

        <p>
          Girls Choice is your place for stylish, beautiful and
          carefully selected products. Explore our collection and
          contact us directly on WhatsApp to place your order.
        </p>
      </div>

      <div class="features">

        <div class="feature">
          <strong>✨ Beautiful Products</strong>
          Carefully selected collection.
        </div>

        <div class="feature">
          <strong>💗 Girls Choice</strong>
          Products chosen with love.
        </div>

        <div class="feature">
          <strong>📱 Easy Ordering</strong>
          Order directly through WhatsApp.
        </div>

        <div class="feature">
          <strong>💎 Fresh Collection</strong>
          New products can be added anytime.
        </div>

      </div>

    </div>
  </div>

</section>

<!-- CONTACT -->
<section id="contact">

  <div class="contact-box">

    <h2>Let's Talk ♡</h2>

    <p>
      Want to order something or ask about a product?
      Contact Girls Choice directly.
    </p>

    <div class="buttons">

      <a class="btn primary"
         href="https://wa.me/923703690659?text=Hello%20Girls%20Choice%2C%20I%20want%20to%20know%20about%20your%20products."
         target="_blank">
        💬 WhatsApp Owner
      </a>

      <a class="btn secondary"
         href="https://wa.me/c/923706903659"
         target="_blank">
        🛍 Open Shop
      </a>

    </div>

    <p style="margin-top:22px;font-weight:600;color:#d62d79;">
      📞 +92 370 3690659
    </p>

  </div>

</section>

</main>

<footer>
  <p>
    © <span id="year"></span>
    <strong>Girls Choice</strong> — Made with ♡
  </p>
</footer>


<!-- ADMIN MODAL -->
<div class="modal" id="adminModal">

  <div class="modal-box">

    <div class="modal-head">
      <h2>⚙ Manage Products</h2>
      <button class="close" onclick="closeAdmin()">×</button>
    </div>

    <p style="font-size:13px;color:#777;margin-bottom:20px;">
      Add products from this panel. Products are saved in this browser.
    </p>

    <div class="form-group">
      <label>Product Name</label>
      <input id="productName" placeholder="Example: Pink Lip Gloss">
    </div>

    <div class="form-group">
      <label>Category</label>
      <select id="productCategory">
        <option>Beauty</option>
        <option>Fashion</option>
        <option>Jewellery</option>
        <option>Accessories</option>
      </select>
    </div>

    <div class="form-group">
      <label>Price</label>
      <input id="productPrice" placeholder="Example: Rs. 1,499">
    </div>

    <div class="form-group">
      <label>Product Image URL</label>
      <input id="productImage"
             placeholder="https://example.com/product.jpg">
    </div>

    <button class="btn primary"
            style="width:100%"
            onclick="addProduct()">
      + Add Product
    </button>

    <div class="admin-products">
      <h3 style="margin-bottom:10px;">Current Products</h3>
      <div id="adminList"></div>
    </div>

  </div>
</div>

<div class="toast" id="toast"></div>


<script>

/* ===============================
   DEFAULT PRODUCTS
================================ */

const defaultProducts = [

  {
    id:1,
    name:"Pink Beauty Set",
    category:"Beauty",
    price:"Rs. 1,499",
    image:"https://images.unsplash.com/photo-1596462502278-27bfdc403348?auto=format&fit=crop&w=900&q=80"
  },

  {
    id:2,
    name:"Elegant Fashion",
    category:"Fashion",
    price:"Rs. 2,999",
    image:"https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=900&q=80"
  },

  {
    id:3,
    name:"Beautiful Jewellery",
    category:"Jewellery",
    price:"Rs. 1,999",
    image:"https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=900&q=80"
  },

  {
    id:4,
    name:"Fashion Accessories",
    category:"Accessories",
    price:"Rs. 999",
    image:"https://images.unsplash.com/photo-1523779917675-b6ed3a42a561?auto=format&fit=crop&w=900&q=80"
  }

];


/* ===============================
   LOAD PRODUCTS
================================ */

let products =
  JSON.parse(localStorage.getItem("girlsChoiceProducts"))
  || defaultProducts;


/* ===============================
   DISPLAY PRODUCTS
================================ */

function displayProducts(category="All"){

  const container = document.getElementById("products");

  let filtered =
    category === "All"
    ? products
    : products.filter(p => p.category === category);

  container.innerHTML = "";

  if(filtered.length === 0){

    container.innerHTML = `
      <div style="grid-column:1/-1;text-align:center;padding:50px">
        <h3>No products found ♡</h3>
      </div>
    `;

    return;
  }

  filtered.forEach((p,index)=>{

    container.innerHTML += `

      <div class="card" style="animation-delay:${index*.08}s">

        <img
          class="product-img"
          src="${escapeHtml(p.image)}"
          alt="${escapeHtml(p.name)}"
          onerror="this.src='https://placehold.co/600x500/fff0f7/d62d79?text=Girls+Choice'"
        >

        <div class="card-body">

          <span class="category">
            ${escapeHtml(p.category)}
          </span>

          <h3>${escapeHtml(p.name)}</h3>

          <div class="price">
            ${escapeHtml(p.price)}
          </div>

          <div class="card-actions">

            <a
              class="buy"
              href="https://wa.me/923703690659?text=${encodeURIComponent("Hello Girls Choice, I want to order: "+p.name)}"
              target="_blank">
              Order
            </a>

            <button
              class="view"
              onclick="showProduct('${escapeJs(p.name)}')">
              Details
            </button>

          </div>

        </div>

      </div>
    `;
  });
}


/* ===============================
   FILTER
================================ */

function filterProducts(category,button){

  document.querySelectorAll(".filter")
    .forEach(btn=>btn.classList.remove("active"));

  button.classList.add("active");

  displayProducts(category);
}


/* ===============================
   ADD PRODUCT
================================ */

function addProduct(){

  const name =
    document.getElementById("productName").value.trim();

  const category =
    document.getElementById("productCategory").value;

  const price =
    document.getElementById("productPrice").value.trim();

  const image =
    document.getElementById("productImage").value.trim();

  if(!name || !price || !image){

    showToast("Please fill all fields.");

    return;
  }

  products.push({

    id:Date.now(),

    name:name,

    category:category,

    price:price,

    image:image

  });

  saveProducts();

  document.getElementById("productName").value="";
  document.getElementById("productPrice").value="";
  document.getElementById("productImage").value="";

  displayProducts();

  renderAdminList();

  showToast("Product added successfully ♡");
}


/* ===============================
   DELETE PRODUCT
================================ */

function deleteProduct(id){

  products =
    products.filter(p => p.id !== id);

  saveProducts();

  displayProducts();

  renderAdminList();

  showToast("Product removed.");
}


/* ===============================
   SAVE
================================ */

function saveProducts(){

  localStorage.setItem(
    "girlsChoiceProducts",
    JSON.stringify(products)
  );

}


/* ===============================
   ADMIN LIST
================================ */

function renderAdminList(){

  const list =
    document.getElementById("adminList");

  list.innerHTML="";

  products.forEach(p=>{

    list.innerHTML += `

      <div class="admin-item">

        <div>
          <strong>${escapeHtml(p.name)}</strong>
          <br>
          <small>${escapeHtml(p.price)}</small>
        </div>

        <button
          class="delete"
          onclick="deleteProduct(${p.id})">
          Delete
        </button>

      </div>
    `;

  });

}


/* ===============================
   ADMIN MODAL
================================ */

function openAdmin(){

  document
    .getElementById("adminModal")
    .classList.add("show");

  renderAdminList();
}

function closeAdmin(){

  document
    .getElementById("adminModal")
    .classList.remove("show");

}


/* ===============================
   PRODUCT DETAILS
================================ */

function showProduct(name){

  alert(
    "♡ Girls Choice ♡\n\n" +
    name +
    "\n\nFor price, availability and order details, contact us on WhatsApp."
  );

}


/* ===============================
   TOAST
================================ */

function showToast(message){

  const toast =
    document.getElementById("toast");

  toast.textContent=message;

  toast.classList.add("show");

  setTimeout(()=>{
    toast.classList.remove("show");
  },2500);

}


/* ===============================
   SECURITY HELPERS
================================ */

function escapeHtml(value){

  return String(value)
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}

function escapeJs(value){

  return String(value)
    .replace(/\\/g,"\\\\")
    .replace(/'/g,"\\'")
    .replace(/"/g,'\\"');

}


/* ===============================
   CLOSE MODAL OUTSIDE
================================ */

document
  .getElementById("adminModal")
  .addEventListener("click",function(e){

    if(e.target === this){
      closeAdmin();
    }

  });


/* ===============================
   START
================================ */

document.getElementById("year").textContent =
  new Date().getFullYear();

displayProducts();

</script>

</body>
</html>
